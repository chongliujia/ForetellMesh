{
  "schema_version": "1",
  "initial_cash": "100",
  "max_trade_usd": "2",
  "max_event_usd": "5",
  "max_portfolio_usd": "20",
  "min_trade_usd": "1",
  "min_edge": "0.03",
  "max_quote_age_seconds": 10800,
  "fill_window_seconds": 300,
  "scenarios": {
    "frictionless_reference": {"entry_price_premium": "0", "fee_fraction": "0"},
    "cost_assumption": {"entry_price_premium": "0.01", "fee_fraction": "0.01"},
    "cost_stress": {"entry_price_premium": "0.03", "fee_fraction": "0.02"}
  },
  "execution_model": "next_post_decision_block_mean_full_fill_assumption",
  "exit_policy": "hold_to_verified_settlement",
